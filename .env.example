# PostgreSQL connection string (the only required database setting).
# - Vercel: set automatically when you connect a database (Project → Storage).
#   Copy it here to run locally against the same database.
# - Local only: run `npm run db:local` and paste the URL it prints, adding
#   `&pgbouncer=true`.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Seed demo products on deploy when the database is empty (set "false" to stop).
SEED_DEMO_DATA="true"

# Shown at the top of the home screen (can also be changed in Admin > Settings per device)
NEXT_PUBLIC_STORE_NAME="Price Assistant"

# Interface language on first visit: "vi" or "en". Users can switch with one tap.
NEXT_PUBLIC_DEFAULT_LOCALE="vi"

# Currency used to display prices (ISO 4217) and the number-format locale.
NEXT_PUBLIC_CURRENCY="VND"
NEXT_PUBLIC_NUMBER_LOCALE="vi-VN"

# Stock at or below this number is shown as "Low stock".
NEXT_PUBLIC_LOW_STOCK_THRESHOLD="5"

# Optional: protect the Admin page with a numeric PIN. Leave empty to disable.
ADMIN_PIN=""

# ---------------------------------------------------------------------------
# Smart Product Recognition (photo → product). All optional: without a key
# the feature shows "not set up" and everything else works as before.
# Keys can also be entered in Admin → Smart Recognition settings; a key set
# here always wins and cannot be changed from the UI.
# ---------------------------------------------------------------------------

# OpenAI key (https://platform.openai.com/api-keys) and/or Gemini key
# (https://aistudio.google.com/apikey). One is enough.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Which one to use when Settings has never been saved: "openai" or "gemini".
# (Default: whichever has a key, OpenAI first.)
AI_VISION_PROVIDER=""

# Model overrides (defaults: gpt-4o / gemini-2.5-flash). Settings page wins.
OPENAI_VISION_MODEL=""
GEMINI_VISION_MODEL=""

# Optional OpenAI-compatible gateway (Azure OpenAI proxy, LiteLLM…).
OPENAI_BASE_URL=""

# Encrypts API keys saved from the Settings page (any long random string,
# e.g. `openssl rand -base64 32`). Changing it later means re-entering keys.
SETTINGS_SECRET=""
